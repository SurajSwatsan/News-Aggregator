model Source {
  id               String    @id @default(uuid())
  name             String
  homepageUrl      String    @map("homepage_url")
  rssUrl           String?   @map("rss_url")
  description      String?
  scrapeConfig     Json?     @map("scrape_config")
  payoutRate       Decimal   @default(0.1) @map("payout_rate") @db.Decimal(10, 2)
  scrapingInterval Int       @default(60) @map("scraping_interval")
  ownerId          String?   @map("owner_id")
  owner            User?     @relation(fields: [ownerId], references: [id])
  isActive         Boolean   @default(true) @map("is_active")
  priority         Int       @default(0)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  articles         Article[]

  @@map("sources")
}

model Article {
  id         String   @id @default(uuid())
  sourceId   String   @map("source_id")
  source     Source   @relation(fields: [sourceId], references: [id])
  title      String
  synopsis   String?
  imageUrl   String?  @map("image_url")
  sourceUrl  String   @unique @map("source_url")
  postedAt   DateTime @map("posted_at")
  category   String?
  city       String?
  state      String?
  country    String?
  clusterId  Int?     @map("cluster_id")
  isManual   Boolean  @default(false) @map("is_manual")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("articles")
}

model PublisherOnboarding {
  id             String           @id @default(uuid())
  token          String           @unique
  email          String
  username       String?
  passwordHash   String?          @map("password_hash")
  status         OnboardingStatus @default(pending)
  orgName        String?          @map("org_name")
  orgWebsite     String?          @map("org_website")
  rssUrl         String?          @map("rss_url")
  orgDescription String?          @map("org_description")
  firstName      String?          @map("first_name")
  lastName       String?          @map("last_name")
  country        String?
  city           String?
  state          String?
  phone          String?
  businessDoc    String?          @map("business_doc")
  newspaperLicense String?        @map("newspaper_license")
  requestedRole  UserRole         @default(reader) @map("requested_role")
  otp            String?          @map("otp")
  otpExpiresAt   DateTime?        @map("otp_expires_at")
  expiresAt      DateTime         @map("expires_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@map("publisher_onboarding")
}

model AccessLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  articleId String   @map("article_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, articleId])
  @@map("access_logs")
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?  @map("user_id")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

model Advertisement {
  id            String   @id @default(uuid()) @map("ad_uuid")
  title         String
  adType        String   @map("ad_type")
  mediaUrl      String   @map("media_url")
  targetUrl     String   @map("target_url")
  placementType String   @map("placement_type")
  position      Int      @default(0)
  createdBy     String   @map("created_by")
  status        String   @default("pending")
  isActive      Boolean  @default(true) @map("is_active")
  impressions   Int      @default(0)
  clicks        Int      @default(0)
  startTime     DateTime? @map("start_time")
  endTime       DateTime? @map("end_time")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("advertisements")
}

model Country {
  id             String   @id @default(uuid())
  name           String   @unique
  isoCode        String?  @map("iso_code")
  mobileCode     String?  @map("mobile_code")
  currency       String?
  currencySymbol String?  @map("currency_symbol")
  states         State[]
  cities         City[]
  status         String   @default("active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("countries")
}

model State {
  id        String   @id @default(uuid())
  name      String
  countryId String   @map("country_id")
  country   Country  @relation(fields: [countryId], references: [id])
  cities    City[]
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([name, countryId])
  @@map("states")
}

model City {
  id        String   @id @default(uuid())
  name      String
  countryId String   @map("country_id")
  country   Country  @relation(fields: [countryId], references: [id])
  stateId   String?  @map("state_id")
  state     State?   @relation(fields: [stateId], references: [id])
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("cities")
}

model SubscriptionPlan {
  id            String   @id @default(uuid())
  name          String   // e.g., Basic Edition, Professional Tier, Elite Premium
  billingCycle  String   // "One Time Purchase" or "Subscription"
  price         Decimal? @db.Decimal(10, 2)
  currency      String?
  features      String[]
  credits       Int      @default(0)
  validityDays  Int      @default(365) @map("validity_days")
  isActive      Boolean  @default(true) @map("is_active")
  subscriptions Json?    // { monthly: { price, currency, features }, yearly: { price, currency, features } }
  createdBy     String?  @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  transactions  PaymentTransaction[]

  @@map("subscription_plans")
}

model PaymentTransaction {
  id                String   @id @default(uuid())
  userId            String   @map("user_id") // Who is paying
  user              User     @relation(fields: [userId], references: [id])
  planId            String   @map("plan_id") // What are they buying
  plan              SubscriptionPlan @relation(fields: [planId], references: [id])
  amount            Int      // Amount in Paise (Razorpay standard)
  currency          String   @default("INR")
  status            String   @default("PENDING") // PENDING, COMPLETED, FAILED
  
  // Razorpay IDs
  razorpayOrderId   String   @unique @map("razorpay_order_id")
  razorpayPaymentId String?  @unique @map("razorpay_payment_id")
  razorpaySignature String?  @map("razorpay_signature")
  credits           Int      // Number of credits to add on success
  
  paymentSnapshot   Json?    @map("payment_snapshot") // Details of the plan at purchase
  createdAt         DateTime @default(now()) @map("created_at")

  @@map("transactions")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      String   // 'PAYMENT_SUCCESS', 'PAYMENT_FAILED', 'INFO', etc.
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notifications")
}
