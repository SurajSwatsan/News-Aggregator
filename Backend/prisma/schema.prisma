generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  publisher
  reader
}

enum OnboardingStatus {
  pending
  registered
  approved
  confirmed
  rejected
  completed
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  username       String?   @unique
  firstName      String?   @map("first_name")
  lastName       String?   @map("last_name")
  name           String?
  orgName        String?   @map("org_name")
  orgWebsite     String?   @map("org_website")
  orgDescription String?   @map("org_description")
  phone          String?
  city           String?
  country        String?
  businessDoc    String?   @map("business_doc")
  newspaperLicense String? @map("newspaper_license")
  passwordHash   String    @map("password_hash")
  role           UserRole  @default(reader)
  creditBalance  Decimal   @default(0) @map("credit_balance") @db.Decimal(10, 2)
  isDeleted      Boolean   @default(false) @map("is_deleted")
  deletedAt      DateTime? @map("deleted_at")
  otp            String?   @map("otp")
  otpExpiresAt   DateTime? @map("otp_expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  sources        Source[]

  @@map("users")
}

model Source {
  id               String    @id @default(uuid())
  name             String
  homepageUrl      String    @map("homepage_url")
  rssUrl           String?   @map("rss_url")
  scrapeConfig     Json?     @map("scrape_config")
  payoutRate       Decimal   @default(0.1) @map("payout_rate") @db.Decimal(10, 2)
  scrapingInterval Int       @default(60) @map("scraping_interval")
  ownerId          String?   @map("owner_id")
  owner            User?     @relation(fields: [ownerId], references: [id])
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  articles         Article[]

  @@map("sources")
}

model Article {
  id         String   @id @default(uuid())
  sourceId   String   @map("source_id")
  source     Source   @relation(fields: [sourceId], references: [id])
  title      String
  synopsis   String?
  imageUrl   String?  @map("image_url")
  sourceUrl  String   @unique @map("source_url")
  postedAt   DateTime @map("posted_at")
  category   String?
  clusterId  Int?     @map("cluster_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("articles")
}

model PublisherOnboarding {
  id             String           @id @default(uuid())
  token          String           @unique
  email          String
  username       String?
  passwordHash   String?          @map("password_hash")
  status         OnboardingStatus @default(pending)
  orgName        String?          @map("org_name")
  orgWebsite     String?          @map("org_website")
  rssUrl         String?          @map("rss_url")
  orgDescription String?          @map("org_description")
  firstName      String?          @map("first_name")
  lastName       String?          @map("last_name")
  country        String?
  city           String?
  phone          String?
  businessDoc    String?          @map("business_doc")
  newspaperLicense String?        @map("newspaper_license")
  requestedRole  UserRole         @default(reader) @map("requested_role")
  otp            String?          @map("otp")
  otpExpiresAt   DateTime?        @map("otp_expires_at")
  expiresAt      DateTime         @map("expires_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@map("publisher_onboarding")
}

model AccessLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  articleId String   @map("article_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, articleId])
  @@map("access_logs")
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?  @map("user_id")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

model Advertisement {
  id            String   @id @default(uuid()) @map("ad_uuid")
  title         String
  adType        String   @map("ad_type")
  mediaUrl      String   @map("media_url")
  targetUrl     String   @map("target_url")
  placementType String   @map("placement_type")
  position      Int      @default(0)
  createdBy     String   @map("created_by")
  status        String   @default("pending")
  isActive      Boolean  @default(true) @map("is_active")
  impressions   Int      @default(0)
  clicks        Int      @default(0)
  startDate     DateTime? @map("start_date")
  endDate       DateTime? @map("end_date")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("advertisements")
}
