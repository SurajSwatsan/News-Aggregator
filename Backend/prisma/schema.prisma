generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  publisher
  reader
}

enum OnboardingStatus {
  pending
  registered
  approved
  confirmed
  rejected
  completed
}

